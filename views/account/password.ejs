<%- include('../partials/header') %>
<section class="card narrow">
  <h1>變更密碼</h1>
  <% if (user.must_change_password) { %>
    <div class="alert alert-info">為了帳號安全，請先設定您自己的新密碼再繼續使用。</div>
  <% } %>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>目前密碼 <input type="password" name="current" autocomplete="current-password" required></label>
    <label>新密碼（至少 8 字元） <input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
    <label>再次輸入新密碼 <input type="password" name="password2" minlength="8" autocomplete="new-password" required></label>
    <button class="btn btn-primary btn-block" type="submit">更新密碼</button>
  </form>
</section>
<%- include('../partials/footer') %>
